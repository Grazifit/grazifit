# ============================================================
# GraziFit — modelo de ambiente
# ============================================================

# ------------------------------------------------------------
# Consumidas pela imagem oficial do PostgreSQL, no docker-compose.
# Os nomes sao ditados pela imagem — nao os renomeie.
# ------------------------------------------------------------

POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PORT=
PEPPER=

# ------------------------------------------------------------
# Consumida pela aplicacao Dart (backend/ e seus testes).
#
# OBRIGATORIA. Sem ela `GraziDatabase.doAmbiente()` lanca StateError.
#
# Formato:
#   postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=disable
#
# HOST e PORTA dependem de ONDE o processo roda:
#   no host da maquina  -> localhost e a POSTGRES_PORT acima
#   dentro do compose   -> banco (nome do servico) e 5432
#
# sslmode=disable porque o Postgres local em container nao serve TLS.
#
# Caractere especial na senha precisa ser percent-encoded: @ vira %40,
# : vira %3A, / vira %2F.
#
# ATENCAO: usuario, senha e banco aqui dentro precisam ser os MESMOS
# das variaveis acima. Sao dois consumidores diferentes lendo a mesma
# verdade — se divergirem, o container sobe e a aplicacao nao conecta.
# ------------------------------------------------------------

DATABASE_URL=
